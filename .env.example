# ==============================================================================
# HH Goa 2026 Voice-Enabled RAG System — Production Environment Configuration
# ==============================================================================

# Core Application Settings
APP_NAME="HH Goa 2026 Voice RAG"
ENVIRONMENT="development"  # 'development' or 'production'
DEBUG=false                # Must be false in production
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["https://yourdomain.com"]  # In production, specify explicit origins (avoid wildcard "*")

# ==============================================================================
# Provider Selection Architecture
# ==============================================================================
# STT Provider: 'mock' (development/testing) or 'sarvam' (production Saarika v2.5)
STT_PROVIDER="sarvam"

# TTS Provider: 'mock' (development/testing) or 'sarvam' (production Bulbul v2)
TTS_PROVIDER="sarvam"

# LLM Provider: 'gemini' (Google Gemini API), 'mock' (development/testing), 'sarvam', or 'openai'
LLM_PROVIDER="gemini"

# Vector Database Provider: 'qdrant_local' (embedded/volume) or 'qdrant_cloud'
VECTOR_PROVIDER="qdrant_local"

# ==============================================================================
# Production External Credentials (Required when using external providers)
# NEVER commit raw keys to version control. Load dynamically from environment.
# ==============================================================================

# Google Gemini API Credentials (Required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# Sarvam AI Credentials (Required for Speech-to-Text & Text-to-Speech)
SARVAM_API_KEY=""
SARVAM_BASE_URL="https://api.sarvam.ai"
SARVAM_STT_MODEL="saarika:v2.5"
SARVAM_TTS_MODEL="bulbul:v2"
SARVAM_TTS_SPEAKER="anushka"

# Qdrant Vector Engine Configuration
# In Docker Compose: http://qdrant:6333
VECTOR_DB_URL="http://qdrant:6333"
VECTOR_DB_API_KEY=""
QDRANT_PATH="data/qdrant"
QDRANT_COLLECTION_NAME="msmarco_xi"

# OpenAI Credentials (Optional if LLM_PROVIDER=openai)
LLM_API_KEY=""
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_LLM_MODEL="gpt-4o-mini"

# ==============================================================================
# Retrieval SLA, Latency Budget & Calibration Thresholds
# ==============================================================================
TOTAL_RETRIEVAL_DEADLINE_MS=200.0
QDRANT_TIMEOUT_MS=157.0
BM25_TIMEOUT_MS=136.0
RERANKER_TIMEOUT_MS=120.0
RERANKER_MIN_BUDGET_MS=40.0
RERANKER_EARLY_EXIT_MARGIN=0.15
PARALLEL_RETRIEVAL_ENABLED=true

# Hybrid Retrieval & Adaptive Reranking Models
EMBEDDING_MODEL="intfloat/multilingual-e5-small"
EMBEDDING_DEVICE="cpu"
LIGHTWEIGHT_RERANKER_MODEL="cross-encoder/mmarco-mMiniLMv2-L12-H384-v1"
RERANKER_MODEL="cross-encoder/mmarco-mMiniLMv2-L12-H384-v1"
HEAVY_RERANKER_ENABLED=false
ADAPTIVE_THRESHOLD_HIGH=0.70
ADAPTIVE_THRESHOLD_LOW=0.40
ADAPTIVE_MEDIUM_K=3
ADAPTIVE_LOW_K=5

# ==============================================================================
# Caching Configuration
# ==============================================================================
RAG_CACHE_ENABLED=true
RAG_CACHE_MAX_SIZE=256
RAG_CACHE_TTL_SECONDS=300

# ==============================================================================
# Security & Rate Limiting (Phase 6.9)
# ==============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30
SECURITY_HEADERS_ENABLED=true
STRICT_CONTENT_TYPE_CHECK=true
MAX_JSON_PAYLOAD_SIZE_BYTES=2097152   # 2 MB max JSON body
MAX_QUERY_LENGTH=2000                 # Max character count for query
MAX_LANGUAGE_LENGTH=32                # Max character count for language code
MAX_AUDIO_SIZE_BYTES=15728640         # 15 MB max audio upload

# ==============================================================================
# Guardrails Configuration
# ==============================================================================
GUARDRAILS_ENABLED=true
GUARDRAIL_MIN_CONFIDENCE=0.0
GUARDRAIL_MIN_RELEVANCE=0.10

# ==============================================================================
# Hugging Face & Model Cache Paths (for Docker Persistent Mounts)
# ==============================================================================
HF_HOME="/app/data/cache/huggingface"
TRANSFORMERS_CACHE="/app/data/cache/huggingface"
